# No external dependencies; sample mode makes no network calls.
TRACEOPS_DATA_MODE=sample
TRACEOPS_MODEL_MODE=sample
TRACEOPS_PORT=8765
# Zetaris UI origin, NOT the raw REST service; HTTPS or loopback HTTP only.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_ENGINE_ID=
# Register the supplied CSV files as these three virtual tables in Zetaris.
ZETARIS_ORDERS_TABLE=traceops.orders
ZETARIS_INVENTORY_TABLE=traceops.inventory
ZETARIS_TICKETS_TABLE=traceops.tickets
# Optional OpenAI-compatible model endpoint; choose the exact model available to you.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
MODEL_NAME=

# Use json_schema for Ollama constrained output; otherwise json_object.
MODEL_RESPONSE_FORMAT=json_object
# Tested local option: http://127.0.0.1:11434/v1, ollama-local, qwen2.5:0.5b
